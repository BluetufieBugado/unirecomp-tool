    <ProjectReference Include="..\shim\AudioModule\UnityEngine.AudioModule.csproj" />
    <ProjectReference Include="..\shim\PhysicsModule\UnityEngine.PhysicsModule.csproj" />
    <ProjectReference Include="..\shim\TextRenderingModule\UnityEngine.TextRenderingModule.csproj" />
    <ProjectReference Include="..\shim\UIModule\UnityEngine.UIModule.csproj" />
    <ProjectReference Include="..\shim\UI\UnityEngine.UI.csproj" />
    <ProjectReference Include="..\shim\TextMeshPro\TextMeshPro-2017.3-Runtime.csproj" />
    <ProjectReference Include="..\shim\ParticleSystem\UnityEngine.ParticleSystemModule.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Silk.NET.Input" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Windowing" Version="2.23.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.7" />
  </ItemGroup>

</Project>
